# 全アプリ共通の環境変数テンプレート。
# packages/env が起動時に zod で検証し、必須値が無ければ即起動失敗する。
NODE_ENV=development

# **どの環境で動いているか**(development / staging / production)。
#
# **NODE_ENV とは別物です。** NODE_ENV は Node と Next の「動作モード」で、
# ビルド最適化やソースマップの有無を決めます——
# **検証環境も本番と同じ production でビルドします**
# (本番と違うものを検証しても意味がないため)。
#
# 「どの環境か」はそれとは別に必要です:
#   ・エラー追跡の振り分け(検証の失敗が本番の障害として鳴らないように)
#   ・通知やメールの宛先(検証から取引先へ送らないように)
#   ・危険な操作の可否(本番でだけ止める)
#
# **設定し忘れたら development** になります(最も権限の弱い側へ倒す)。
APP_ENV=development

DATABASE_URL=postgresql://app:app@localhost:5432/app?schema=public

# ── 踏み台(bastion)経由で DB につなぐとき ────────────────────
# 本番の DB はインターネットから直接つながらないのが普通で、AWS なら
# RDS をプライベートサブネットに置き、踏み台 EC2 を経由する。
#
#   手元のPC ──SSH──> 踏み台EC2 ──> RDS(プライベート)
#
# **BASTION_HOST を設定したときだけ**トンネルを使う。
# 本番のアプリは同じ VPC 内にあるので、設定せずに直接つなぐ。
#
# 使い方: import { withTunnel } from "@platform/db/tunnel";
#
# BASTION_HOST=bastion.example.com
# BASTION_USER=ec2-user
# BASTION_PORT=22
# 鍵は ~/.ssh/config に書く方が安全。ここで指定することもできる:
# BASTION_IDENTITY_FILE=~/.ssh/bastion.pem
# 踏み台から見た DB のホスト(省略すると DATABASE_URL から取る):
# BASTION_DB_HOST=db.xxxxx.ap-northeast-1.rds.amazonaws.com
# BASTION_DB_PORT=5432
# 手元で待ち受けるポート(省略すると空きを自動で選ぶ):
# BASTION_LOCAL_PORT=15432

# メール(mail パッケージ)
# MAIL_TRANSPORT は運用者が選ぶ入口。**基盤は読まず**、アプリが値を見て
# smtp / resend のどちらのアダプタを作るかを決める。
MAIL_TRANSPORT=smtp          # smtp | resend
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.co.jp
RESEND_API_KEY=

# ログ(logger パッケージ)
LOG_LEVEL=info               # trace|debug|info|warn|error|fatal

# エラー追跡(任意。未設定なら無効)
SENTRY_DSN=

# トレースの送り先(OTLP)。**未設定なら送らない**——ログにだけ出る。
# 送り先を決めたらここに書くだけで送れる(Grafana Cloud / Tempo / Jaeger / Datadog 等)
OTLP_ENDPOINT=
# 認証ヘッダ。`名前: 値` をカンマ区切りで
OTLP_HEADERS=

# キャッシュ / ジョブ(Redis)
REDIS_URL=redis://localhost:6379

# 通知(任意)
SLACK_WEBHOOK_URL=
# Slack Web API(スレッド返信・受信を使う場合。通知だけなら Webhook で足りる)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Notion(連携先のページ/DBをインテグレーションに共有しておくこと)
NOTION_TOKEN=
NOTION_DATABASE_ID=

# 暗号化(必須: 十分に長くランダムな秘密鍵)
SESSION_SECRET=
# 入れ替え中だけ設定する 1 つ前の鍵(手順: docs/ops/SECRET_ROTATION.md)
SESSION_SECRET_PREVIOUS=
CSRF_SECRET=
ENCRYPTION_SECRET=

# 全文検索(Meilisearch。使う場合)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# 外部連携(使うものだけ設定。OAuthトークンの取得・更新はアプリ側で行う)
#
# **基盤(packages/*)はこれらを直接読まない。** アダプタは
# `createFreeeClient({ accessToken })` のように**引数で受け取る**設計なので、
# コードを `FREEE_ACCESS_TOKEN` で検索しても呼び出し箇所は出てこない
# (`grep` して見つからないのは設定漏れではない)。
# 値をここから読んでアダプタへ渡すのはアプリ側の責任。
LINE_CHANNEL_ACCESS_TOKEN=
FREEE_ACCESS_TOKEN=
GOOGLE_ACCESS_TOKEN=
# 口座残高アプリ（balance-app）
# 定期取得を叩くための共有鍵。**未設定だと実行できない**（開けっ放しにしない）
COLLECT_SECRET=
# 記録の保存先。未設定だとメモリになり、再起動で月末の記録まで消える
# DATABASE_URL は既存のものを使う

# Microsoft 365 / Entra ID(テナントは必ず自社の ID。common は他社アカウントも通る)
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REFRESH_TOKEN=

ZOHO_API_DOMAIN=https://www.zohoapis.jp
ZOHO_ACCESS_TOKEN=

# 決済(Stripe / PayPal)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# AI(社内資料アシスタント等。@platform/ai のゲートウェイ経由でのみ使う)
ANTHROPIC_API_KEY=

# Google Maps(Sheets/Calendar はアクセストークン、Maps は API キー)
GOOGLE_MAPS_API_KEY=
