// 備品管理の Prisma スキーマ(PostgreSQL)。備品 + 貸出履歴(子レコード)。
generator client {
  provider = "prisma-client-js"
  // **アプリごとに生成先を分ける。** 既定(node_modules/@prisma/client)のままだと
  // 全アプリが 1 つの生成物を奪い合い、**最後に generate したアプリしか型が通らない**。
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model EquipmentRow {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  note      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model LendingRow {
  id         String  @id @default(cuid())
  code       String
  borrower   String
  lentAt     String
  returnedAt String?
  @@index([code])
}
