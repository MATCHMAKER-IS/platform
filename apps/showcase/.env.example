# showcase(基盤の使い方を示す画面)の設定。
#
# **DB は要りません。** データはすべてメモリかモックです。
# ここに挙げた鍵は、対応するデモを動かすときだけ必要になります。
# 未設定でもアプリは起動し、その画面が「未設定」と表示するだけです。

# ── セッション(ログインのデモ) ──────────────────
# 32 文字以上。**開発用でも使い回さない**(他の環境の鍵で入られる)
SESSION_SECRET=change-me-to-a-32-characters-or-longer-value
# 鍵の導出に使う塩。secret とは別の値にする
SESSION_SALT=change-me-to-another-long-value
# フォーム送信のデモで使う
CSRF_SECRET=change-me-to-another-long-value

# ── 外部サービス(接続テストのデモ) ────────────────
# **どれも任意。** 設定した鍵のデモだけが動きます。
# 本物の鍵を入れると、その先へ実際に通信します
ANTHROPIC_API_KEY=
NOTION_TOKEN=
SLACK_BOT_TOKEN=
# **自社テナントの ID。** `common` エンドポイントを使うと他社のアカウントでも
# ログインできるため、**確認しないと誰でも入れる**
MICROSOFT_TENANT_ID=
SLACK_SIGNING_SECRET=
STRIPE_KEY=
TRUSTDOCK_KEY=

# ── 以下は「設定の確認」デモが名前を挙げるもの ──────────
# **画面で名前を表示するだけ**で、showcase 自身は使いません。
# 実運用のアプリで何が要るかを見せるための一覧です。
DATABASE_URL=
REDIS_URL=
ENCRYPTION_SECRET=
ENCRYPTION_SALT=
WEBHOOK_SECRET=
LOG_LEVEL=info
PORT=3001
DEBUG_TOOL=
ENABLE_CACHE=
GOOGLE_MAPS_API_KEY=
LINE_CHANNEL_ACCESS_TOKEN=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
STRIPE_SECRET_KEY=
