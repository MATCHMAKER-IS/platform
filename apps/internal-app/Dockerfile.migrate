# syntax=docker/dockerfile:1
# スキーマ適用専用イメージ(docker-compose.prod.yml の migrate サービス)。
# 実行: docker compose -f docker-compose.prod.yml run --rm migrate
#
# **方式は固定しない。** `tools/apply-schema.mjs` が
# `prisma/migrations/` の有無を見て選ぶ:
#   履歴なし → `prisma db push`   (開発中。ADR 0013)
#   履歴あり → `prisma migrate deploy` (本番で安全な唯一の方法。ADR 0014)
#
# **ここを `db push` に固定してはいけない。** `pnpm db baseline` で
# マイグレーションへ切り替えたときに**本番だけ古い方式のまま残り**、
# ADR 0014 が禁じている「本番で db push」になる——列の削除が無警告で走る。
# `check-migration-mode` がこの固定を見張っている。
#
# ⚠ prisma のバージョンは packages/db の指定に追随させること。

FROM node:22-bookworm-slim
WORKDIR /repo
RUN npm install -g pnpm@9 prisma@7.2.0
COPY tools/apply-schema.mjs ./tools/apply-schema.mjs
COPY apps/internal-app/prisma ./apps/internal-app/prisma
COPY apps/internal-app/prisma.config.ts ./apps/internal-app/prisma.config.ts
# DATABASE_URL / APP_ENV は env_file から供給
CMD ["node", "tools/apply-schema.mjs", "internal-app"]
