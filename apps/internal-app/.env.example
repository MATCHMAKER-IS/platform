# internal-app の環境変数。このファイルを .env にコピーして使う(.env は git 管理外)。
# setup.sh が未作成なら自動コピーする。

# --- 必須 ---
# **どの環境で動いているか**(development / staging / production)。
# NODE_ENV(ビルドの動作モード)とは別物です——
# **検証環境も本番と同じ production でビルドします**
# (本番と違うものを検証しても意味がないため)。
# エラー追跡の振り分け・通知の宛先・危険な操作の可否がこれで変わります。
# 設定し忘れたら development(最も権限の弱い側へ倒す)。
APP_ENV=development
DATABASE_URL=postgresql://app:app@localhost:5432/app
MAIL_FROM=no-reply@example.com
SESSION_SECRET=dev-session-secret-change-me
# **1 つ前のセッション鍵**(入れ替え中だけ設定する)。
# 鍵を替えると**全員が即ログアウト**します。ここに旧鍵を入れておくと、
# 読むときだけ旧鍵も試すので、利用者は気づかないまま新しい鍵へ移ります。
# **有効期間(7 日)より長く待ってから消すこと。** 手順: docs/ops/SECRET_ROTATION.md
# SESSION_SECRET_PREVIOUS=
# **セッションの暗号化に使う塩。** `@platform/session` の `createSession` が必須にしている
# (`deriveKey` に渡す)。**環境ごとに別の値**にすること——同じ塩だと、
# 検証環境のクッキーが本番でも通る。8 文字以上。
#
# **まだ使っていない。** `zoho-session.ts` は今も HMAC 署名だけで、
# **クッキーを見れば email と roles が読める**(改ざんはできないが隠れていない)。
# 暗号化へ移す手順は `apps/internal-app/src/server/zoho-session.ts` の冒頭にある。
# **差し替えた瞬間に全員がログアウト**するので、出す時間帯を決めてから。
# **本番では必須**（未設定なら起動時に落ちます）。
# **環境ごとに必ず別の値にしてください**——同じ塩だと
# **検証環境で発行したクッキーが本番でも通ります**。
SESSION_SALT=dev-session-salt-change-me

# --- 任意(既定値あり) ---
LOG_LEVEL=info

# --- AI Gateway(@platform/ai)。未設定ならモックで動作(要約はダミー) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=            # RAG のベクトル埋め込み(@platform/ai createOpenAiEmbedder)に使う場合
SMTP_HOST=localhost
SMTP_PORT=1025

# --- 開発専用ログイン(ローカルで動かすときはこれを 1 に) ---
# このアプリのログインは Zoho SSO だけなので、鍵が無いと**全 API が 401** になり
# ローカルでは何も試せない。1 にすると /api/auth/dev-login でセッションを張れる。
# **本番では NODE_ENV=production の判定でも塞いである**(二重の守り)。
#   http://localhost:3000/api/auth/dev-login
#   http://localhost:3000/api/auth/dev-login?email=me@example.co.jp&roles=admin
DEV_LOGIN=1

# --- 口座残高(balance-app から統合。/balance 画面)---
# 未設定なら**見本データで動く**(画面に「見本のデータです」と明示される)。
# 鍵が無いと真っ白になる作りだと、壊れているのか設定不足かが分からないため。
# FREEE_CLIENT_ID=
# FREEE_CLIENT_SECRET=
# FREEE_REFRESH_TOKEN=                 # 回転するので、更新の運用が要る
# FREEE_COMPANY_ID=                    # 事業所 ID(数値)
# COLLECT_SECRET=                      # 定期取得 POST /api/balance/collect の共有鍵(16文字以上)

# --- 永続化 ---
# **既定は DB に保存します**(DATABASE_URL が必須なので、使わない理由がない)。
# 以前は CHAT_/FAQ_/CONTRACT_/TASK_PERSISTENCE の 4 つに分かれ、どれも既定が
# メモリでした。「シードを入れたのに画面が空」という事故の原因だったため統合しました。
#
# 実験用にメモリで動かしたいときだけ指定します(**再起動で消えます**)。
# PERSISTENCE=memory

# --- 運用系(使う機能に応じて) ---
# CRON_TOKEN=change-me                 # cron 系 API の X-Cron-Token
# SECRET_MASTER_KEY=                   # 秘密情報ストアの暗号鍵(未設定は SESSION_SECRET を流用)
# PREVIEW_TOKEN=change-me              # CMS プレビュー(public-site と同じ値)
# INQUIRY_INTAKE_TOKEN=change-me       # 公開サイトからの問い合わせ受付(public-site と同じ値)
# PUBLIC_SITE_URL=http://localhost:3004
# PUBLIC_UPLOADS_URL=
# APP_BASE_URL=http://localhost:3000    # 配信停止リンクの生成に使う。本番は https の実 URL を設定すること
# ALLOWED_MAIL_DOMAINS=                 # 取引先向けメールの誤送信防止(カンマ区切り)。本番は制限しないので空でよい
# VAPID_PUBLIC_KEY=                     # Web Push。3 つ揃って初めて有効になる(generateVapidKeys() で 1 度だけ生成)
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:no-reply@example.com
# TWILIO_ACCOUNT_SID=                   # SMS-OTP(TOTP 未設定者向けの代替2FA)。3つ揃って初めて有効になる
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# MAINTENANCE_ALLOW_IPS=
# MAINTENANCE_BYPASS_TOKEN=
# DISABLE_NOTIFY_RELAY=1
# IDLE_TIMEOUT_MINUTES=30
# SENTRY_DSN=

# --- トレースの送り先(任意) ---
# **未設定なら送りません。** その場合トレースは構造化ログにだけ出ます
# ——`docker logs` で追えますが、**コンテナを入れ替えると消えます**。
# 送り先を決めたら、この 1 行を足すだけで送れます(OTLP を受けるものなら何でも)。
# OTLP_ENDPOINT=http://collector:4318/v1/traces
# 認証が要る場合。`名前: 値` をカンマ区切りで
# OTLP_HEADERS=Authorization: Bearer xxx

# --- 認可・セッションの調整(既定値あり) ---
# SESSION_TTL_SEC=28800                # セッション有効秒数
# ALLOWED_EMAIL_DOMAINS=example.co.jp  # ログイン許可ドメイン(カンマ区切り)
# DEFAULT_ROLES=member                 # 新規ユーザーの既定ロール
# ROLE_MAP=                            # メール→ロールの割当(例: boss@example.co.jp:admin)

# --- MCP サーバ(pnpm --filter internal-app mcp)---
# MCP_ENABLE_WRITES=0                  # 1 で書き込みツール(invoice_record_payment/cancel)を有効化
# MCP_API_KEY_SCOPES=invoice:read      # 許可スコープ(invoice:read,invoice:write)

# --- Zoho 連携 / MCP の zoho_* ツールを使うとき(Self Client で発行) ---
# ZOHO_DC=jp                            # データセンター(日本は jp。**間違えると認証は通るが空の結果が返る**)
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# --- Zoho SSO(「Zoho でログイン」を使うとき) ---
# **ID / CLIENT_SECRET / REDIRECT_URI の 3 つが揃ったときだけ**、
# ログイン画面に「Zoho でログイン」が出ます(片方だけでは動かないため)。
# ZOHO_REDIRECT_URI=http://localhost:3000/api/auth/zoho/callback
# ZOHO_SCOPE=

# --- Platform Debugger(開発時のみ) ---
# true にすると /debug でリクエストの中身(SQL・AI・所要時間)を確認できる。
# 本番(NODE_ENV=production)では設定しても強制的に無効になる。
# DEBUG_TOOL=true

# --- システムアラートの通知先(任意。未設定ならログのみ) ---
# ALERT_MAIL_TO=ops@example.com
# ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/xxx

# ── セッション・権限（2026-08 に .env.example へ追記） ──
# **コードは読んでいたのに、ここに書いていませんでした**
# ——引き継いだ人が「何を設定すればよいか」に気づけない状態でした。

# セッションの有効期間（秒）。既定 28800 = 8 時間
SESSION_TTL_SEC=28800

# ログイン時に割り当てる既定のロール（カンマ区切り）
DEFAULT_ROLES=viewer

# メールアドレスからロールを決める対応表（JSON）
# 例: {"admin@example.com":["admin"]}
ROLE_MAP={}

# ログインを許すメールのドメイン（カンマ区切り）。**空だと全部許します**
ALLOWED_EMAIL_DOMAINS=

# ── Zoho 連携 ──
# **`ZOHO_DC` を間違えると 401 になります**（日本なら jp）。
# 「認証情報が違う」と見えますが、実際は**別のデータセンターを叩いています**。
ZOHO_DC=jp
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# **リフレッシュトークンは 1 度しか表示されません**（控えてください）
ZOHO_REFRESH_TOKEN=
ZOHO_REDIRECT_URI=http://localhost:3000/api/zoho/callback
ZOHO_SCOPE=ZohoCRM.modules.ALL

# ── 遅いクエリの記録（2026-08 追加） ──
# **既定は無効です。** 有効にすると Prisma のクエリログが有効になり、
# **わずかに遅くなります**——「遅い」と言われたときだけ 1 にしてください。
#
# 500ms を超えたクエリだけが記録されます（`slowQueryLog.summary()` で見られます）。
# 見方は docs/ops/SLOW_TRIAGE.md へ。
SLOW_QUERY_LOG=0
