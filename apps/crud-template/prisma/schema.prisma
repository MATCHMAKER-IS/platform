// CRUDテンプレートの Prisma スキーマ(PostgreSQL)。エンティティを差し替えて使う。
generator client {
  provider = "prisma-client-js"
  // **アプリごとに生成先を分ける。** 既定(node_modules/@prisma/client)のままだと
  // 全アプリが 1 つの生成物を奪い合い、**最後に generate したアプリしか型が通らない**。
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ItemRow {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  note      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}
