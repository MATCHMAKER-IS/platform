{
  "name": "platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "advisor": "node tools/advisor.mjs",
    "apps": "pnpm -r --filter './apps/*' exec node -e \"console.log(process.env.npm_package_name)\"",
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "build:no-turbo": "pnpm -r --workspace-concurrency=1 run build",
    "build:turbo": "node tools/turbo-guard.mjs run build",
    "changeset": "changeset",
    "check": "pnpm typecheck && pnpm lint && pnpm smoke",
    "check:api": "node tools/api-surface.mjs",
    "check:app-ci": "node tools/check-app-ci.mjs",
    "check:build": "node tools/check-build-ready.mjs",
    "check:bundle": "node tools/check-bundle-size.mjs",
    "check:coverage": "node tools/check-coverage.mjs",
    "check:deps": "node tools/check-deps.mjs",
    "check:incubating": "node tools/check-incubating-review.mjs",
    "check:indexes": "node tools/check-db-indexes.mjs",
    "check:input-validation": "node tools/check-input-validation.mjs",
    "check:licenses": "node tools/check-licenses.mjs",
    "check:loops": "node tools/check-query-in-loop.mjs",
    "check:mail-dns": "node tools/check-mail-dns.mjs",
    "check:safety": "node tools/check-safety-parts.mjs",
    "check:schema-types": "node tools/check-schema-types.mjs",
    "check:showcase": "node tools/check-showcase-deps.mjs",
    "check:unreachable": "node tools/check-unreachable-modules.mjs",
    "clean": "node tools/clean.mjs --all",
    "clean:build": "node tools/clean.mjs",
    "db": "node tools/db.mjs",
    "db:down": "docker compose stop db mailpit",
    "db:psql": "docker compose exec db psql -U app -d app",
    "db:reset": "pnpm db:down && pnpm db:up",
    "db:up": "docker compose up -d db mailpit",
    "debt": "node tools/debt.mjs",
    "debt:record": "node tools/debt.mjs --record",
    "debt:tighten": "node tools/debt.mjs --tighten",
    "deps:why": "pnpm why",
    "dev": "pnpm -r --parallel run dev",
    "dev:clean": "node tools/dev-clean.mjs",
    "dev:crud": "pnpm --filter crud-template dev",
    "dev:internal": "pnpm --filter internal-app dev",
    "dev:line": "pnpm --filter line-console dev",
    "dev:no-turbo": "pnpm -r --parallel run dev",
    "dev:showcase": "pnpm --filter showcase dev",
    "dev:site": "pnpm --filter public-site dev",
    "dev:turbo": "node tools/turbo-guard.mjs run dev",
    "docs:apps": "echo \"アプリ側ドキュメントは docs/apps/ を参照\"",
    "docs:platform": "typedoc",
    "doctor": "node tools/doctor.mjs",
    "drill": "node tools/drill.mjs",
    "drill:dry": "node tools/drill.mjs --dry",
    "dup": "node tools/duplication.mjs",
    "e2e": "node tools/e2e.mjs",
    "e2e:ui": "playwright test --ui",
    "fresh": "pnpm clean && pnpm install",
    "gen:all": "node tools/gen-all.mjs",
    "gen:appmap": "node tools/gen-app-map.mjs",
    "gen:depgraph": "node tools/gen-depgraph.mjs",
    "gen:docs-index": "node --experimental-strip-types tools/gen-docs-index.mts",
    "gen:erd": "node tools/gen-erd.mjs",
    "gen:portal-reference": "node tools/gen-portal-reference.mjs",
    "gen:reference": "node tools/gen-reference.mjs",
    "gen:site": "node tools/gen-ref-site.mjs",
    "i18n:check": "node tools/i18n-check.mjs",
    "lint": "pnpm -r --workspace-concurrency=1 run lint",
    "lint:turbo": "node tools/turbo-guard.mjs run lint",
    "loadtest": "node --experimental-strip-types tools/loadtest.mjs",
    "mcp": "pnpm --filter internal-app mcp",
    "mcp:catalog": "node --experimental-strip-types tools/mcp-catalog.mts",
    "new-app": "node tools/new-app.mjs",
    "outdated": "pnpm -r outdated || true",
    "platform:check": "node tools/platform-sync.mjs",
    "platform:sync": "node tools/platform-sync.mjs --apply",
    "postinstall": "node tools/postinstall.mjs",
    "sbom": "node tools/gen-sbom.mjs",
    "scaffold": "node tools/scaffold.mjs",
    "seed": "node tools/seed-all.mjs",
    "seed:line": "pnpm --filter line-console seed",
    "setup": "bash scripts/setup.sh",
    "site": "pnpm gen:site && node -e \"console.log('docs/site/index.html をブラウザで開いてください')\"",
    "smoke": "node --experimental-strip-types tools/smoke.mjs",
    "suggest": "node tools/suggest.mjs",
    "test": "pnpm exec vitest run",
    "test:coverage": "pnpm exec vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary",
    "test:no-turbo": "pnpm exec vitest run",
    "test:pkg": "pnpm --filter",
    "test:turbo": "node tools/turbo-guard.mjs run test",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
    "typecheck:turbo": "node tools/turbo-guard.mjs run typecheck",
    "verify": "pnpm check:deps && pnpm check:api && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "verify:apps": "node tools/preflight.mjs --apps-only",
    "verify:offline": "node tools/preflight.mjs && node tools/check-generated.mjs",
    "version-packages": "changeset version",
    "ws:demo": "node tools/ws-demo-server.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.18.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-security": "^3.0.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "turbo": "^2.10.7",
    "typedoc": "^0.27.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4",
    "ws": "^8.18.0"
  }
}
